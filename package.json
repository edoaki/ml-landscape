{
  "name": "ml-landscape",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs && node tests/test_ssm_animation.cjs",
    "test:browser": "node tests/check-browser.mjs",
    "browser:install": "playwright install chromium",
    "check:dist": "node scripts/check-dist.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:links": "node scripts/check-sources.mjs --online"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "entities": "8.1.0",
    "markdown-it": "15.0.2",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-cjk-friendly": "3.0.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  }
}
